{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/glm-5.3",
  "update": "disable",
  "permissions": [
    {"action": "*", "resource": "*", "effect": "deny"}
  ],
  "policies": [
    {"action": "provider.use", "resource": "*", "effect": "deny"},
    {"action": "provider.use", "resource": "opencode-go", "effect": "allow"},
    {"action": "mcp.use", "resource": "*", "effect": "deny"},
    {"action": "mcp.use", "resource": "toothless_browser", "effect": "allow"},
    {"action": "plugin.use", "resource": "*", "effect": "deny"},
    {"action": "skill.use", "resource": "*", "effect": "deny"},
    {"action": "tool.use", "resource": "subagent:*", "effect": "deny"}
  ],
  "plugin": [],
  "mcp": {
    "servers": {
      "toothless_browser": {
        "type": "local",
        "command": ["/home/toothless-agent/.local/share/toothless/browser-smoke/venv/bin/python", "/usr/local/libexec/toothless/browser_mcp_bridge.py"],
        "cwd": "/home/toothless-agent/workspace",
        "disabled": false,
        "codemode": false,
        "timeout": {"startup": 20000, "catalog": 20000, "execution": 20000}
      }
    }
  },
  "agents": {
    "toothless-browser": {
      "description": "Owner-approved public research with a network-filtered guest browser",
      "mode": "primary",
      "model": "opencode-go/glm-5.3",
      "steps": 12,
      "permissions": [
        {"action": "*", "resource": "*", "effect": "deny"},
        {"action": "external_directory", "resource": "*", "effect": "deny"},
        {"action": "toothless_browser_navigate", "resource": "*", "effect": "allow"},
        {"action": "toothless_browser_extract_text", "resource": "*", "effect": "allow"},
        {"action": "toothless_browser_click_link", "resource": "*", "effect": "allow"},
        {"action": "toothless_browser_click_button", "resource": "*", "effect": "allow"},
        {"action": "toothless_browser_screenshot", "resource": "*", "effect": "allow"},
        {"action": "toothless_browser_download", "resource": "*", "effect": "allow"},
        {"action": "toothless_browser_close_session", "resource": "*", "effect": "allow"}
      ]
    }
  }
}
